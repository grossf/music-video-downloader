# Shared secret between the addon and the server. Any random string.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=change-me

# Host path that becomes the Jellyfin "Music Videos" library.
# Local dev on Windows:  MEDIA_HOST_PATH=./.local/media
# Home server:           MEDIA_HOST_PATH=/srv/media/music-videos
MEDIA_HOST_PATH=./.local/media
DATA_HOST_PATH=./.local/data

# Run as this user and group so downloaded files are not owned by root.
# Find yours with `id` on the server. Leave empty to run as root.
# Switching an existing library over? Hand it to that user once first:
#   sudo chown -R 1000:1000 /srv/media/music-videos
PUID=1000
PGID=1000

# Update yt-dlp on every container start. YouTube breaks old versions
# regularly; a restart then fixes downloads without rebuilding the image.
YTDLP_AUTO_UPDATE=true

DOWNLOAD_CONCURRENCY=1
LOG_LEVEL=INFO

# Optional. When unset, library refreshes are skipped silently.
# On the same docker host, reach Jellyfin over the shared network, e.g.
# JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_URL=
JELLYFIN_API_KEY=
