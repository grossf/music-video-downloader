# Shared secret between the addon and the server. Any random string.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=change-me

# Host path that becomes the Jellyfin "Music Videos" library.
# Local dev on Windows:  MEDIA_HOST_PATH=./.local/media
# Home server:           MEDIA_HOST_PATH=/srv/media/music-videos
MEDIA_HOST_PATH=./.local/media
DATA_HOST_PATH=./.local/data

DOWNLOAD_CONCURRENCY=1
LOG_LEVEL=INFO

# Optional. When unset, library refreshes are skipped silently.
# On the same docker host, reach Jellyfin over the shared network, e.g.
# JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_URL=
JELLYFIN_API_KEY=
